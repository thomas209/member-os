{
  "name": "member-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/db-guard.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node scripts/db-guard.mjs && prisma migrate dev",
    "db:reset": "node scripts/db-guard.mjs && prisma migrate reset",
    "db:push": "node scripts/db-guard.mjs && prisma db push",
    "db:studio": "node scripts/db-guard.mjs && prisma studio",
    "db:backup": "node scripts/db-backup.mjs",
    "db:copy-to-local": "node scripts/db-copy-prod-to-local.mjs",
    "db:deploy-prod": "node scripts/db-deploy-prod.mjs",
    "db:ensayo": "node scripts/db-ensayo-deploy.mjs",
    "db:deploy-staging": "node scripts/db-deploy-staging.mjs",
    "db:copy-to-staging": "node scripts/db-copy-prod-to-staging.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@mercadopago/sdk-js": "^0.0.3",
    "@prisma/client": "5.22.0",
    "@react-email/components": "^1.0.12",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "mercadopago": "^3.1.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "next-cloudinary": "^6.17.5",
    "prisma": "5.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
