// ============================================================
// Member OS — Prisma Schema v1.0
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ADMIN
// ============================================================

model AdminUser {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          AdminRole  @default(OPERATOR)
  isActive      Boolean    @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([email])
  @@index([role, isActive])

  cashRegisterSessions CashRegisterSession[]
}

// ============================================================
// TAXONOMY
// ============================================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([slug])
  @@index([isActive, sortOrder])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([slug])
  @@index([isActive])
}

// ============================================================
// CATALOG
// ============================================================

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  gender      Gender    @default(UNISEX)

  price         Decimal   @db.Decimal(10, 2)
  comparePrice  Decimal?  @db.Decimal(10, 2)
  salePrice     Decimal?  @db.Decimal(10, 2)
  saleEndsAt    DateTime?
  costPrice     Decimal?  @db.Decimal(10, 2)
  costCurrency  Currency  @default(ARS)

  colorName   String?
  colorHex    String?
  groupSlug   String?

  metaTitle       String?
  metaDescription String?

  weightGrams Int?
  lengthCm    Decimal?  @db.Decimal(6, 2)
  widthCm     Decimal?  @db.Decimal(6, 2)
  heightCm    Decimal?  @db.Decimal(6, 2)

  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  isEncargo   Boolean   @default(false)
  // Donde se puede retirar: "PINAMAR", "CABA" o "AMBOS"
  pickupLocation String @default("PINAMAR")
  deletedAt   DateTime?

  mlProductId String?   @unique
  mlStatus    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  orderItems  OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([groupSlug])
  @@index([isActive, isFeatured, deletedAt])
  @@index([isActive, categoryId, deletedAt])
  @@index([isActive, brandId, deletedAt])
  @@index([deletedAt])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  sku       String?  @unique
  stock     Int      @default(0)
  sortOrder Int      @default(0)
  mlVariantId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, size])
  @@index([productId, sortOrder])
  @@index([sku])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

// ============================================================
// INVENTORY
// ============================================================

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id])
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id          String   @id @default(cuid())
  email       String   @unique
  phone       String?
  firstName   String
  lastName    String
  defaultAddress Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  quoteRequests QuoteRequest[]

  // Login por link magico (sin contraseña). Un solo token activo a la vez:
  // se pisa cada vez que se pide uno nuevo y se borra al usarse.
  loginToken          String?   @unique
  loginTokenExpiresAt DateTime?

  // CRM interno (solo lo ve el admin, nunca el cliente)
  notes String? @db.Text
  tags  String[] @default([])

  @@index([email])
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int          @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  orders         Order[]

  @@index([code, isActive])
  @@index([validFrom, validUntil])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())

  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])

  guestEmail      String?
  guestFirstName  String?
  guestLastName   String?
  guestPhone      String?

  status      OrderStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2) @default(0)
  shippingCost   Decimal @db.Decimal(10, 2) @default(0)
  total          Decimal @db.Decimal(10, 2)

  couponId   String?
  coupon     Coupon?  @relation(fields: [couponId], references: [id])
  couponCode String?

  shippingAddress Json?

  channel               String  @default("ONLINE")
  paymentMethod         String?
  cashRegisterSessionId String?
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])

  shippingMethod String?
  trackingNumber String?
  shippingLabel  String?

  paymentId     String? @unique
  paymentStatus String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([guestEmail])
  @@index([status])
  @@index([paymentId])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  productName  String
  productBrand String
  size         String
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  // Copia de Product.isEncargo al momento de la compra (igual que
  // productName/productBrand): asi si despues el producto deja de ser
  // encargo, el pedido viejo no cambia de estado retroactivamente.
  isEncargo    Boolean @default(false)

  // Despacho por item: permite despachar un pedido en varias tandas (ej:
  // lo que hay en stock ya, el encargo despues) sin dejar de ser un solo
  // pedido/pago. Order.trackingNumber sigue existiendo como "ultimo
  // numero cargado" para compatibilidad con pedidos viejos de una sola
  // tanda; el detalle por item vive aca.
  trackingNumber String?
  shippedAt      DateTime?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum Gender {
  HOMBRE
  MUJER
  UNISEX
  NINO
}

enum Currency {
  ARS
  USD
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum StockMovementType {
  PURCHASE
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCELLED
}
model CashRegisterSession {
  id                    String    @id @default(cuid())
  openedById            String
  openedBy              AdminUser @relation(fields: [openedById], references: [id])
  openingAmount         Decimal   @db.Decimal(10, 2)
  cartItems             Json      @default("[]")
  status                String    @default("OPEN")
  openedAt              DateTime  @default(now())
  closedAt              DateTime?
  closingAmountCounted  Decimal?  @db.Decimal(10, 2)
  orders                Order[]

  @@index([status])
}

// ============================================================
// QUOTE REQUESTS (pedidos de cotizacion)
// ============================================================
// La tabla existe en produccion desde el 13/8 (migracion
// 20260813180000_add_quote_request). El feature que la usaba se revirtio,
// pero el modelo se mantiene para que schema, migraciones y base coincidan.
// NO borrar este modelo: generaria una migracion que borra la tabla.
enum QuoteRequestStatus {
  PENDING
  QUOTED
  REJECTED
}

model QuoteRequest {
  id          String             @id @default(cuid())
  customerId  String?
  customer    Customer?          @relation(fields: [customerId], references: [id])
  guestEmail  String?
  guestPhone  String?
  description String
  imageUrl    String?
  productLink String?
  size        String?
  status      QuoteRequestStatus @default(PENDING)
  quotedPrice Decimal?           @db.Decimal(10, 2)
  adminNote   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

// ============================================================
// MODULO DE REDES E IA (FEATURE_SOCIAL)
// Tablas nuevas, no modifican ninguna existente.
// ============================================================

// Voz de la marca: se arma como instruccion de sistema para la IA.
// La propone el analisis del perfil de Instagram y Tommy la edita.
model BrandVoice {
  id         String    @id @default(cuid())
  tone       String    @default("")
  doWords    String[]
  dontWords  String[]
  examples   String[]
  insights   Json?     // analisis del perfil: estilo visual, hashtags, que rinde mas
  analyzedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

// Registro de cada llamada a la IA: lo que propuso, tokens y si se acepto.
model AiGeneration {
  id           String   @id @default(cuid())
  kind         String   // caption | product_description | profile_analysis | reply
  input        Json
  output       String
  status       String   @default("suggested") // suggested | accepted | edited | discarded
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([kind, status])
}

// Cuenta de red social conectada (por ahora Instagram). El token se guarda
// cifrado con AES-GCM (clave en SOCIAL_TOKEN_KEY), nunca en texto plano.
model SocialAccount {
  id                String    @id @default(cuid())
  platform          String    // "instagram"
  externalId        String
  handle            String?
  profilePictureUrl String?
  accessTokenEnc    String
  tokenExpiresAt    DateTime?
  status            String    @default("active") // active | reauth_required | disconnected
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([platform, externalId])
}

// Plantilla de Canva para armar la imagen de los posts. Es un diseno de
// Canva con campos de "Data autofill" (foto, titulo, precio, etc.).
model SocialTemplate {
  id            String   @id @default(cuid())
  name          String
  canvaDesignId String   @unique
  dataset       Json     // campos de la plantilla: { nombre: { type } }
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Publicaciones armadas desde Member OS. Nada se publica sin approvedAt.
// El paso a "publishing" se hace con un update condicional para que un post
// nunca se publique dos veces.
model ScheduledPost {
  id             String    @id @default(cuid())
  accountId      String
  productIds     String[]
  caption        String
  mediaUrls      String[]
  mediaType      String    @default("image") // image | carousel
  scheduledAt    DateTime?
  status         String    @default("draft") // draft | approved | paused | publishing | published | failed
  idempotencyKey String    @unique @default(uuid())
  remoteId       String?
  permalink      String?
  lastError      String?
  attempts       Int       @default(0)
  approvedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
}

// Inbox de mensajes (Instagram ahora, WhatsApp despues). Tablas propias:
// no se relacionan por FK con clientes ni pedidos existentes.
model Conversation {
  id              String    @id @default(cuid())
  platform        String    // instagram | whatsapp
  externalId      String    // id de la conversacion en la plataforma
  participantId   String    // IGSID / telefono del cliente
  participantName String?
  lastMessageAt   DateTime?
  lastInboundAt   DateTime? // ultimo mensaje del cliente (ventana de 24 hs)
  unread          Boolean   @default(false)
  status          String    @default("open") // open | closed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]

  @@unique([platform, externalId])
  @@index([platform, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?      @unique
  direction      String       // in | out
  text           String?
  attachments    Json?
  sentBy         String       @default("customer") // customer | tommy | bot | app
  sentAt         DateTime
  createdAt      DateTime     @default(now())

  @@index([conversationId, sentAt])
}

// Ajustes simples de la app (clave/valor). Ej: "social.autoreply" = off|test|on
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
